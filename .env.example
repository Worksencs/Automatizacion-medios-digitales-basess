# Base de datos local (Docker Compose)
DATABASE_URL="postgresql://nexo:nexo_demo@localhost:5434/nexo?schema=public"

# Modo demo no realiza llamadas externas
DEMO_MODE="true"
APP_URL="http://localhost:3000"
AUTH_SECRET="cambie-este-valor-en-entornos-reales"
EDITORIAL_TIMEZONE="America/Guatemala"

# OpenAI (opcionales; active DEMO_MODE=false para usarlas)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4"

# Claude (opcional; tiene prioridad para los autores de producción)
ANTHROPIC_API_KEY=""
ANTHROPIC_ENABLED="false"
ANTHROPIC_MODEL="claude-sonnet-5"
ANTHROPIC_EDITORIAL_MODEL=""
ANTHROPIC_PRODUCTION_MODEL=""
ANTHROPIC_BASE_URL="https://api.anthropic.com"

# Notion (opcionales; el ID debe ser el data source de la base)
NOTION_API_KEY=""
NOTION_DATABASE_ID=""
NOTION_API_VERSION="2026-03-11"

# Seguridad de URLs externas
TRUSTED_DOMAINS="inguat.gob.gt,congreso.gob.gt,muniguate.com,prensalibre.com,lahora.gt"
RSS_TIMEOUT_MS="8000"
RSS_MAX_BYTES="2000000"
